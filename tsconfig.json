{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "target": "es2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "DOM"],
    "jsx": "react",
    "resolveJsonModule": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.stories.tsx",
    "packages/stash-ui/stash/**/*"
  ],
  "include": [
    "packages/mock-stash/**/*",
    "packages/tv-ui/**/*",
    "packages/tv-plugin/**/*",
    "packages/stash-ui/wrappers/**/*",
    "packages/stash-ui/dist/src/@types/**/*",
    "packages/stash-ui/dist/src/components/ScenePlayer/*.d.ts"
  ]
}
