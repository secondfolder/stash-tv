{
  "name": "stash-tv",
  "version": "0.0.0-version-set-when-releasing",
  "description": "TikTok for Stash.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "resolutions": {
    "graphql": "16.14.2"
  },
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "yarn --cwd packages/stash-ui build-if-needed && yarn --cwd packages/tv-ui dev",
    "build": "yarn --cwd packages/stash-ui build && yarn --cwd packages/tv-ui build && yarn --cwd packages/tv-plugin build",
    "test": "yarn --cwd packages/repo test && yarn --cwd packages/mock-stash test && yarn --cwd packages/tv-ui test && yarn --cwd packages/tv-plugin test",
    "test:watch": "yarn --cwd packages/tv-ui test:watch",
    "test:conformance": "yarn --cwd packages/mock-stash test:conformance",
    "test:e2e": "yarn --cwd packages/mock-stash test:e2e-server & sleep 5 && STASH_ADDRESS=http://localhost:4000 STASH_PROXY=true yarn --cwd packages/tv-ui dev & sleep 10 && yarn --cwd packages/tv-ui test:e2e",
    "preview": "yarn --cwd packages/tv-ui preview",
    "storybook": "storybook dev -p 6006",
    "release": "node node_modules/.bin/light-release && yq -i '.version = \"'$(jq -r '.version' package.json)'\"' packages/tv-plugin/source.yml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secondfolder/stash-tv.git"
  },
  "author": "secondfolder",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/secondfolder/stash-tv/issues"
  },
  "homepage": "https://github.com/secondfolder/stash-tv#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@commitlint/prompt-cli": "^20.4.1",
    "@semantic-release/exec": "^7.1.0",
    "@tsconfig/recommended": "^1.0.10",
    "commitlint": "^20.4.1",
    "js-yaml": "^4.1.1",
    "semantic-release": "^25.0.3",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "cross-env": "^7.0.3"
  }
}
